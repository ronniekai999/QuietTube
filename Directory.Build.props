<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.1</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\..\work\nuget</RestorePackagesPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\work\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\work\dotnet-build\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
